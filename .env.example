# ============================================================================
# Counterforge environment variables
# ============================================================================
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# (.env is already in .gitignore — your key must live ONLY here.)
#
# Phase 1 (the public front-end with sample data) needs NONE of these — it runs
# with `npm run dev` and no configuration. These are all for Phase 2 (real data
# ingestion + aggregation), which only runs once you have a Riot API key.
# ============================================================================

# --- Data source ------------------------------------------------------------
# Which provider the front-end reads from:
#   sample  (default) -> synthetic Phase 1 data, shows the "Sample data" badge
#   db                -> real computed stats from PostgreSQL (Phase 2)
# If set to "db" but the DB has no aggregated rows yet, the site automatically
# falls back to sample data so it never renders blank.
DATA_SOURCE=sample

# --- Riot API (Phase 2 only) ------------------------------------------------
# >>> PASTE YOUR RIOT API KEY HERE <<<
# A development key works for local testing (expires every 24h). A PRODUCTION
# key is required for a public site — obtain one by submitting your working
# prototype at https://developer.riotgames.com/
RIOT_API_KEY=

# REGIONAL routing for match-v5 + account-v1: americas | europe | asia | sea
RIOT_REGION=americas

# PLATFORM routing for league-v4 + summoner-v4: na1 | euw1 | eun1 | kr | br1 | …
# Must be a platform inside RIOT_REGION (e.g. na1/br1 -> americas; euw1 -> europe).
RIOT_PLATFORM=na1

# Ranked queue id to ingest (420 = Ranked Solo/Duo, 440 = Ranked Flex)
RIOT_QUEUE_ID=420

# --- Ingestion tuning (Phase 2 only) ----------------------------------------
# Rate-limit tier for the ingest/seed scripts:
#   dev  (default) -> stays under personal/dev key limits (~100 req / 2 min)
#   prod           -> uses higher production-key windows (much faster)
# Using "prod" speed with a dev key gets you throttled with 429s — keep "dev"
# until you have a PRODUCTION key.
RIOT_RATE_PROFILE=dev
# How much one `npm run ingest` run pulls. Defaults are small on the dev profile
# so a first run finishes in a few minutes; raise them once you have a prod key.
INGEST_MAX_SEEDS=10
INGEST_MATCHES_PER_SEED=20

# --- Database (Phase 2 only) ------------------------------------------------
# PostgreSQL connection string for raw matches + computed aggregates.
DATABASE_URL=postgres://user:password@localhost:5432/counterforge

# --- On-demand revalidation (optional, Phase 2) -----------------------------
# Secret that guards POST /api/revalidate. If unset, that endpoint is disabled.
# The aggregation job can POST here after each run to refresh cached pages.
REVALIDATE_TOKEN=
