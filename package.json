{
  "name": "counterforge",
  "version": "0.1.0",
  "private": true,
  "description": "League of Legends champion counter-pick statistics site (Phase 1 front-end + Phase 2 backend scaffold).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test backend/**/*.test.ts",
    "seed": "tsx backend/ingest/seed.ts",
    "ingest": "tsx backend/ingest/worker.ts",
    "aggregate": "tsx backend/aggregate/job.ts",
    "db:migrate": "tsx backend/db/migrate.ts",
    "dev:fixtures": "tsx backend/dev/loadFixtures.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "next": "^14.2.35",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
